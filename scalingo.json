{
  "$schema": "https://raw.githubusercontent.com/Scalingo/developers-documentation/master/scalingo.schema.json",
  "name": "scalingo-gotenberg",
  "description": "Gotenberg + nginx - libreoffice", 
  "repository": "https://github.com/jquagliatini/scalingo-gotenberg",
  "stack": "scalingo-24",
  "formation": {
    "web": {
      "amount": 1,
      "size": "M"
    }
  },
  "env": {
    "GOTENBERG_HEALTH_TIMEOUT": {
      "description": "Délai (en secondes) laissé à gotenberg pour répondre 2xx sur /health au démarrage avant que supervisord ne le relance.",
      "value": "90"
    }
  }
}
